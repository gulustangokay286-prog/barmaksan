# barmaksan.chenki.net → barmaksan_api (127.0.0.1:8096)
server {
    listen 80;
    listen [::]:80;
    server_name barmaksan.chenki.net;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name barmaksan.chenki.net;

    ssl_certificate /etc/letsencrypt/live/barmaksan.chenki.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/barmaksan.chenki.net/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Orijinal dosyalar sıkıştırılmadan yüklenir; büyük videolar için geniş sınır.
    client_max_body_size 4g;
    proxy_request_buffering off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location / {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
